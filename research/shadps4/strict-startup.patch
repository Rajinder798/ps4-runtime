+// PS4 Runtime research, 18 October 2026: bounded OpenOrbis startup services.
+// No host fd/errno constants cross this boundary.
+s32 PS4_SYSV_ABI posix_poll(Core::ResearchServices::PollFd* fds, u64 count, s32 timeout) {
+    auto* table = Common::Singleton<Core::FileSys::HandleTable>::Instance();
+    const auto result = Core::ResearchServices::Poll(fds, count, timeout, [&](s32 fd) {
+        return table->WithFile(fd, [](Core::FileSys::File* file) {
+            using Kind = Core::ResearchServices::PollKind;
+            using Type = Core::FileSys::FileType;
+            if (!file || !file->is_opened) {
+                return Kind::Invalid;
+            }
+            if (file->type == Type::Regular) {
+                return Kind::Regular; // is_opened is published after backend open.
+            }
+            if (file->type == Type::Directory) {
+                return Kind::Regular;
+            }
+            // Only the three known std logger paths have supported readiness.
+            return file->type == Type::Device && file->device &&
+                           (file->m_guest_name == "/dev/stdin" ||
+                            file->m_guest_name == "/dev/stdout" ||
+                            file->m_guest_name == "/dev/stderr")
+                       ? Kind::Logger : Kind::Unsupported;
+        });
+    }, [](int milliseconds) { std::this_thread::sleep_for(std::chrono::milliseconds{milliseconds}); });
+    if (result.error) {
+        *__Error() = result.error;
+    }
+    LOG_DEBUG(Kernel_Fs, "research poll count={} timeout={} result={} errno={}",
+              count, timeout, result.value, result.error);
+    return result.value;
+}
+
+// Match the upstream integer-register varargs bridge. Only F_SETFD consumes
+// RDX; getters never read a nonexistent optional argument or a host va_list.
+s32 PS4_SYSV_ABI posix_fcntl(VA_ARGS) {
+    const s32 fd = static_cast<s32>(rdi);
+    const s32 command = static_cast<s32>(rsi);
+    const u64 argument = command == 2 ? static_cast<u32>(rdx) : 0;
+    auto* table = Common::Singleton<Core::FileSys::HandleTable>::Instance();
+    const auto result = table->WithFile(fd, [&](Core::FileSys::File* file) {
+        if (!file || !file->is_opened) {
+            return Core::ResearchServices::Result{-1, POSIX_EBADF};
+        }
+        return Core::ResearchServices::Fcntl(file->research_state, command, argument);
+    });
+    if (result.error) {
+        *__Error() = result.error;
+    }
+    LOG_DEBUG(Kernel_Fs, "research fcntl fd={} cmd={} result={} errno={}",
+              fd, command, result.value, result.error);
+    return result.value;
+}
