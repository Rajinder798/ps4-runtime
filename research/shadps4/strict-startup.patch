+// PS4 Runtime research, 18 October 2026. WILLNEED is a real host prefetch;
+// all other nonempty advice fails until its BSD semantics are implemented.
+s32 PS4_SYSV_ABI posix_madvise(void* address, u64 length, s32 advice) {
+    const auto result = Core::ResearchServices::Madvise(reinterpret_cast<u64>(address), length,
+        advice, [](u64 cursor) -> u64 {
+            OrbisVirtualQueryInfo info{};
+            if (Core::Memory::Instance()->VirtualQuery(cursor, 0, &info) != ORBIS_OK ||
+                !info.is_committed || info.start > cursor || info.end <= cursor ||
+                !(info.protection & ORBIS_KERNEL_PROT_CPU_READ)) {
+                return 0;
+            }
+            return info.end;
+        }, [](u64 start, u64 size) -> int {
+#if defined(_WIN32)
+            WIN32_MEMORY_RANGE_ENTRY range{reinterpret_cast<void*>(start), static_cast<SIZE_T>(size)};
+            if (PrefetchVirtualMemory(GetCurrentProcess(), 1, &range, 0)) {
+                return 0;
+            }
+            const auto error = GetLastError();
+            return error == ERROR_NOT_ENOUGH_MEMORY || error == ERROR_OUTOFMEMORY
+                       ? POSIX_ENOMEM : POSIX_EINVAL;
+#else
+            return ::madvise(reinterpret_cast<void*>(start), size, MADV_WILLNEED) == 0
+                       ? 0 : POSIX_ENOMEM;
+#endif
+        });
+    if (result.error) {
+        *__Error() = result.error;
+    }
+    LOG_DEBUG(Kernel_Vmm, "research madvise addr={} len={} advice={} result={} errno={}",
+              fmt::ptr(address), length, advice, result.value, result.error);
+    return result.value;
+}
